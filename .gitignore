# Claude Code credentials and session state — never commit these
.credentials.json
*.local.json

# These live in ~ not in the repo, but guard against accidental inclusion
.claude.json

# Plugin runtime state — written by Claude Code itself, not config
# (installed_plugins.json / known_marketplaces.json are tracked on purpose —
# they're what makes plugins sync across machines; see plugins/.gitignore
# for the actual cache/marketplace downloads that ARE excluded)
plugins/.last_inuse_sweep

# Secrets that might accidentally end up here
*.env
.env.*
*secret*
*token*
*password*


*#*#
*#*.*#
*~
*.*~
